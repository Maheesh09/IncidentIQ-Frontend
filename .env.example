# Copy to .env.local (git-ignored) and fill in the values.
# CI reads the same names from the repository's GitHub Actions variables:
#   gh variable list -R Maheesh09/IncidentIQ-Frontend

# Backend base URL. Defaults to /api when unset.
VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public identifiers, not secrets, but keep them out of the repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=incidentiq-2b6e1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=incidentiq-2b6e1
VITE_FIREBASE_APP_ID=
